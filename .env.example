# Configurações do Servidor
PORT=3000
NODE_ENV=production
DOMAIN=shapemestre.acessaronline.com.br

# Provedor padrão de IA: 'gemini' ou 'openai'
DEFAULT_AI_PROVIDER=gemini

# Google Gemini API (Recomendado para velocidade e visão de fotos)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (Para Whisper de áudio e fallback)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Evolution API (WhatsApp)
# URL da sua Evolution API na VPS (ex: http://localhost:8080 ou https://evolution.seudominio.com.br)
EVOLUTION_API_URL=
# Chave de autenticação da Evolution API
EVOLUTION_API_KEY=
# Nome da instância criada na Evolution API
EVOLUTION_INSTANCE=ShapeMestre

# Banco de Dados (Opcional - já integrado na VPS)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/shapemestre
REDIS_URL=redis://localhost:6379
